{
  "name": "nim-react-toastify",
  "version": "1.0.5",
  "description": "One-command global notification (toast) setup for React, React Native/Expo, and Next.js",
  "bin": {
    "nim-react-toastify": "cli.js"
  },
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "react-native": "./src/provider.rn.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "react-native": "src/provider.rn.js",
  "license": "MIT",
  "keywords": [
    "react",
    "react-native",
    "nextjs",
    "toast",
    "notification",
    "cli",
    "scaffold",
    "nim-toastify",
    "react-native-toastify",
    "react-native-toast",
    "zaynmiraj",
    "ZaYn Miraj",
    "nim-react-toastify"
  ],
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@types/react": "^19.2.2"
  }
}
